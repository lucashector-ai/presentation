{
  "name": "presentation",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma privada de apresentações criativas — MVP",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "wrangler dev --config dist/server/wrangler.json --port 8787",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "lint": "vinext lint",
    "typecheck": "vinext typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verificar": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:e2e": "node e2e/fluxo.mjs",
    "cursores": "node scripts/gerar-cursores.ts",
    "db:migrar": "node db/migrar.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@google/model-viewer": "^4.4.0",
    "@neon/config": "^1.9.3",
    "@neondatabase/auth": "0.6.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/por": "1.0.0",
    "dompurify": "^3.4.17",
    "fflate": "0.8.2",
    "fzstd": "0.1.1",
    "isomorphic-dompurify": "^4.6.0",
    "jspdf": "4.2.1",
    "kiwi-schema": "0.5.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.460.0",
    "modern-screenshot": "4.7.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "tesseract.js": "7.0.0",
    "three": "^0.183.2",
    "vinext": "^1.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261021.1",
    "@napi-rs/canvas": "1.0.13",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "playwright": "1.56.1",
    "postcss": "^8.4.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3",
    "ws": "8.18.3"
  },
  "type": "module"
}
