# Headers dos assets estáticos do Cloudflare (servidos sem passar pelo Worker, então o headers() do next.config.js
# não chega neles). Com este arquivo o vinext não gera o dele, por isso a regra de cache imutável está aqui também.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
