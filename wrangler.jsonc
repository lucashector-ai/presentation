// Worker do Mostra (vinext no Cloudflare Workers). `npm run build` gera dist/server/wrangler.json a partir deste arquivo;
// `npm run preview` e `npm run deploy` usam o gerado. Segredos (DATABASE_URL etc.): .dev.vars no local, `wrangler secret put` em produção.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mostra",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  // worker/index.ts delega ao vinext e exporta a classe do Durable Object da sala de colaboração
  "main": "./worker/index.ts",
  // Origem pública do site (lib/site.ts). As NEXT_PUBLIC_* são inlinadas no build; esta fica aqui também para o
  // código do servidor que lê process.env em tempo de execução. Local e workers.dev continuam funcionando
  // (lib/site.ts usa a origem do pedido nesses hosts).
  "vars": { "NEXT_PUBLIC_SITE_URL": "https://mostra.page" },
  // Domínio próprio: Custom Domains do Worker (criam o DNS e o certificado sozinhos). Só funcionam com a zona
  // mostra.page ATIVA na conta; enquanto ela não existir, o `wrangler deploy` falha com as rotas ligadas, por isso
  // ficam comentadas. Passo a passo e ordem de ativação em docs/dominio.md.
  // "routes": [
  //   { "pattern": "mostra.page", "custom_domain": true },
  //   { "pattern": "www.mostra.page", "custom_domain": true }
  // ],
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"]
  },
  // Mídias dos projetos (originais + variantes). Acesso só por lib/cf/ambiente.ts. No local, o Wrangler simula o bucket.
  "r2_buckets": [{ "binding": "MIDIAS", "bucket_name": "mostra-midias", "preview_bucket_name": "mostra-midias" }],
  // Sala de colaboração: um Durable Object (SQLite) por projeto, com WebSockets em hibernação (lib/colab/sala.ts).
  "durable_objects": { "bindings": [{ "name": "SALAS", "class_name": "SalaProjeto" }] },
  "exports": { "SalaProjeto": { "type": "durable-object", "storage": "sqlite" } },
  "observability": { "enabled": true }
}
