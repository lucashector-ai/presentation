# Copie para .env.local e preencha. Nunca versione segredos.
# O Worker local (npm run dev / npm run preview, no workerd) lê as variáveis do servidor de .dev.vars (mesmo formato).
# Em produção: `npx wrangler secret put NOME`. As NEXT_PUBLIC_* entram no build.

# Origem pública do site (lib/site.ts: links de compartilhamento, convites, metadados, checagem de origem).
# Padrão https://mostra.page; em localhost e no workers.dev o app usa a origem do próprio pedido, então só mude
# para apontar para outro domínio. NEXT_PUBLIC_APP_URL é o nome antigo e ainda é aceito.
NEXT_PUBLIC_SITE_URL=https://mostra.page

# Modo demonstração: a UI roda com dados fictícios locais, sem tocar no banco (útil para o protótipo navegável).
# Sem ele (ou com 0), login/cadastro usam o Neon Auth e as rotas /api usam o Neon Postgres.
NEXT_PUBLIC_DEMO=1

# Neon Postgres (preenchidas por `neon deploy` / `neon env pull` em .env.local)
# DATABASE_URL: conexão com pooler, usada pelo app; DATABASE_URL_UNPOOLED: direta, para migrações (npm run db:migrar)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Neon Auth (Managed Better Auth; `auth: true` em neon.ts → `neon deploy` preenche as duas primeiras)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Segredo do app (32+ caracteres; `openssl rand -base64 32`) que assina o cookie de cache da sessão. Só no servidor.
NEON_AUTH_COOKIE_SECRET=

# Segredo (32+ caracteres aleatórios) que assina o cookie de acesso de convidado a links com senha. Só no servidor.
SHARE_GRANT_SECRET=

# Mídias: no Worker vêm do binding R2 `MIDIAS` (wrangler), sem variável. Fora dele, armazenamento de desenvolvimento:
# pasta em disco (padrão .armazenamento-dev/; obrigatória em `next start` fora do Worker) ou ARMAZENAMENTO_DEV=memoria.
ARMAZENAMENTO_DEV_DIR=
ARMAZENAMENTO_DEV=

# Claude (Criar com IA). Só no servidor. Sem chave, o "Criar com IA" usa o gerador local de roteiros.
ANTHROPIC_API_KEY=
