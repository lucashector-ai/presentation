# Copie para .env.local e preencha. Nunca versione segredos.

# Supabase (Postgres + Auth + Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor (rotas /api). Jamais expor ao navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Bucket privado de mídias (originais + variantes). Criado pela migration 0000.
MIDIAS_BUCKET=midias

# URL pública do app (links de compartilhamento, e-mails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Modo demonstração: a UI roda com dados fictícios locais, sem tocar no banco (útil para o protótipo navegável).
NEXT_PUBLIC_DEMO=1

# Segredo (32+ caracteres aleatórios) que assina o cookie de acesso de convidado a links com senha. Só no servidor.
SHARE_GRANT_SECRET=

# Claude (Criar com IA). Só no servidor. Sem chave, o "Criar com IA" usa o gerador local de roteiros.
ANTHROPIC_API_KEY=
